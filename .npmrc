auto-install-peers=true
strict-peer-dependencies=false

# Flat node_modules layout (no symlinked .pnpm store).
# Required so Next.js standalone output correctly copies all transitive deps
# (e.g. @swc/helpers) into .next/standalone/node_modules. Without this, the
# pnpm symlinked layout confuses Next's file tracer and runtime imports fail
# with `Cannot find module '@swc/helpers/_/_interop_require_default'`.
node-linker=hoisted
